          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "born with a wellspring of wisdom, possibility, purpose, and power.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Somewhere along the way, like many of us, you may have forgotten the pure potency of your soul, or ",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "maybe",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " you have remembered but are continuing to mend, reclaim, and stand tall in the magnificence of you.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "I've come to know that there is an art to living wholeheartedly, and that is what I want for you.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "​",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "A life lived…In the glory of love.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "With a courageous willingness to meet it all.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Knowing your pain carves passageways for your gifts to awaken.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Knowing your trails can turn into artistic masterpieces.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Knowing the depth of your power, intuition, and sensuality.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Knowing the divine channel for heaven and earth you are.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Knowing your very existence is a living prayer.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Knowing your presence, voice, and purpose matters significantly.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Darling, this life is your canvas, ready for the vibrant strokes",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "of your dreams and the brilliance of your authenticity.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "​"
                    }
                  ]
                }
              ]
            }
          }
        }
