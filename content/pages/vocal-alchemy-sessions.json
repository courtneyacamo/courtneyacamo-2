              ]
            }
          }
        },
        {
          "id": "blk_s410f5vdfk",
          "type": "image",
          "v": 1,
          "fields": {
            "image": {
              "src": "media/2026/11/2a148f-bd49607a293a447ea7fc8d84d167f9fb--wayx.png",
              "alt": "",
