                          "type": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "- Rebecca Lash",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
