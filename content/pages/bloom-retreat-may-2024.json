      "blocks": [
        {
          "id": "blk_835t9f8n3q",
          "type": "component/imported-bloom-retreat-may-2024-7",
          "v": 1,
          "fields": {
            "text1": "Essence...",
            "text2": "Embrace Your",
            "image3": {
              "src": "media/2026/11/you-are-invited-1-tkgy.png",
              "alt": "",
              "width": 471,
              "height": 469,
              "mediaId": "med_tkgy7mwxph"
            },
            "text4": "Step into this journey dedicated to nourishing your mind, body, and soul. Here, we will weave incredible experiences for you to connect with your true self and let go of all that isn't serving you.",
            "text5": "From immersive water ceremonies to the gift of learning new songs, from dancing under the starry sky to the comforting embrace of kindred souls. You will be held and guided into knowing a more empowered, joyous, and aligned YOU.",
            "text6": "​"
          }
        }
      ]
    },
    {
      "id": "sec_5hpcb2wmd4",
      "preset": "starter/stack-12@1",
      "anchor": "comp-lprs7v43",
      "layout": {
