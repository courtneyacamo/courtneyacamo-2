        {
          "id": "blk_sdvkpybw0p",
          "type": "text",
          "v": 1,
          "column": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "“My soul needed this. I felt enveloped with a deep sense of joy and belonging that I have never experienced so strongly before. I knew this experience was a gift from Spirit. I really loved the incredible energy of nature surrounding this beautiful home and is all over this sacred island. The love shared by Courtney was an inspiring gift from the first moment of connection.”",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "​",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "- Rebecca Lash",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "style": {
            "align": {
              "d": "center"
            }
          }
        }
      ]
    },
