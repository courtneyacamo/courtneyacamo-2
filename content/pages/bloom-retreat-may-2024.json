        {
          "id": "blk_k9xe76wv4q",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "WHERE YOU'LL "
                    },
                    {
                      "type": "text",
                      "text": "be",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " STAYING"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "You will be welcomed to my home, the \"Heart Temple.\" A radiant sanctuary surrounded by the vibrant nature of Kauai. A magical oasis filled with wild birds, blooming flowers, and fruit trees. You'll enjoy majestic mountain views with cascading waterfalls, exclusive access to our private saltwater pool and jacuzzi, and the ocean within a scenic ten-minute drive.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Our amazing chef will provide delicious brunch, dinner, and yummy snacks daily."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This special six-day gathering will take place",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "May 15-20, 2024",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "​"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The retreat will be intimate and limited to six women beautiful women who feel the call."
                    }
                  ]
                }
              ]
            }
          },
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
